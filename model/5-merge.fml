# --- Trade fees, per customer group ------------------------------------------------------

"Trade Fees ACT part" { "Customer Group", Versions, Years, Months } = if(eq("FC Actual", 1), "IMPORT Trade Fees")
  @rollup sum
  @folder "Merge"
  @readonly true

"Trade Fees Pool" { "Customer Group", Versions, Years, Months } = "Trade Fees ACT part" + "Trade Fees PLAN part"
  @rollup sum
  @folder "Merge"
  @notes "Trade fees to spread to the group's customers and SKUs."
  @readonly true

# --- Marketing spend, per brand and country -------------------------------------------

"Marketing ACT part" { Brand, Country, Versions, Years, Months } = if(eq("FC Actual", 1), "IMPORT Marketing")
  @rollup sum
  @folder "Merge"
  @readonly true

"Marketing Pool" { Brand, Country, Versions, Years, Months } = "Marketing ACT part" + "Marketing PLAN part"
  @rollup sum
  @folder "Merge"
  @notes "Marketing spend to allocate to customers and SKUs."
  @readonly true

# --- Operating expenses ------------------------------------------------------------------

"OPEX ACT part" { "Cost Center", Account, Versions, Years, Months } = if(eq("FC Actual", 1), "IMPORT OPEX")
  @rollup sum
  @folder "Merge"
  @readonly true

"OPEX" { "Cost Center", Account, Versions, Years, Months } = "OPEX ACT part" + "OPEX PLAN part"
  @rollup sum
  @folder "Merge"
  @readonly true
