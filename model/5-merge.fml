  @folder "Merge"
  @readonly true

"Standard Discounts" { Customer, SKU, Versions, Years, Months } = "Standard Discounts ACT part" + "Standard Discounts PLAN part"
  @rollup sum
  @folder "Merge"
  @readonly true

"Promo Discounts ACT part" { Customer, SKU, Versions, Years, Months } = if(eq("FC Actual", 1), "Promo Discounts ACT")
  @rollup sum
  @folder "Merge"
  @readonly true

"Promo Discounts" { Customer, SKU, Versions, Years, Months } = "Promo Discounts ACT part" + "Promo Discounts PLAN part"
  @rollup sum
  @folder "Merge"
  @readonly true

# --- Rebates ------------------------------------------------------------------------

"Rebates ACT part" { Customer, SKU, Versions, Years, Months } = if(eq("FC Actual", 1), "Rebates ACT")
  @rollup sum
  @folder "Merge"
  @readonly true

"Rebates" { Customer, SKU, Versions, Years, Months } = "Rebates ACT part" + "Rebates PLAN part"
  @rollup sum
  @folder "Merge"
  @readonly true

# --- Cost of goods sold ---------------------------------------------------------------

"COGS ACT part" { Customer, SKU, Versions, Years, Months } = if(eq("FC Actual", 1), "COGS ACT")
  @rollup sum
  @folder "Merge"
  @readonly true

"COGS" { Customer, SKU, Versions, Years, Months } = "COGS ACT part" + "COGS PLAN part"
  @rollup sum
  @folder "Merge"
