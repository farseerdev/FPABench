# ============================================================================
# Layer 5. Merge actuals and plan into one value per version.
#
# For every primary line: ACT part + PLAN part. "FC Actual" and "FC Plan"
# never overlap, so the sum never double counts. The ACT part broadcasts a
# version-free actual onto each version that knows the month.
# Everything downstream reads only these merged lines, so it serves all
# versions with one formula.
# ============================================================================

# --- Volume ---------------------------------------------------------------------

"Volume ACT part" { Customer, SKU, Versions, Years, Months } = if(eq("FC Actual", 1), "Volume ACT")
  @rollup sum
  @folder "Merge"
  @readonly true

"Volume" { Customer, SKU, Versions, Years, Months } = "Volume ACT part" + "Volume PLAN part"
  @rollup sum
  @folder "Merge"
  @notes "Units sold. Actual or plan, depending on the version and month."
  @readonly true

# --- Gross sales ------------------------------------------------------------------

"Gross Sales ACT part" { Customer, SKU, Versions, Years, Months } = if(eq("FC Actual", 1), "Gross Sales ACT")
  @rollup sum
  @folder "Merge"
  @readonly true

"Gross Sales" { Customer, SKU, Versions, Years, Months } = "Gross Sales ACT part" + "Gross Sales PLAN part"
  @rollup sum
  @folder "Merge"
  @readonly true

