# ============================================================================
# Layer 6. Gross-to-net subtotals and cost allocation, down to the three
# contribution margins.
#
# Everything down to gross margin is per customer and SKU. Rebates and the
# growth bonus are rates on sales. Trade fees are fixed amounts per group and
# brand, spread by sales. So gross margin is a management margin at standard
# cost, after allocated trade deductions. Trade fees do not move with one
# SKU's volume, and standard cost can hold fixed factory overhead. So gross
# margin does not show what dropping a SKU would save.
#
# The costs below gross margin are fixed pools, so they stop at customer and
# brand. Spread over SKUs, they would give numbers that mislead a decision
# about a single SKU. Contribution margin II takes off the cost to serve,
# logistics and the sales force. Contribution margin III takes off marketing.
#
# Four pools are allocated, each with its own key. Trade fees are a pool per
# customer group and brand, allocated by invoice sales. Logistics is a pool
# per country, allocated by shipped kg weighted by temperature zone. Sales
# force is a pool per channel and country, allocated by invoice sales.
# Marketing is a pool per brand and country, allocated by net sales.
# Each allocation is the same steps: the key's total at the pool grain, the
# key itself (share of the total), pool times key, and what the pool could not
# place. Every pool stays inside one country, so no currencies get mixed.
#
# Keys count only positive drivers, at the grain the allocation runs at. The
# trade fee key drops a SKU line whose returns beat its sales, so a customer
# still gets a share through its other SKUs. The cost keys drop a customer and
# brand whose returns beat its sales. A pool with no positive driver at all,
# such as launch spend before the first sale, stays unallocated. Layer 7 still
# takes it off the country's profit.
# ============================================================================

# --- Per customer and SKU -----------------------------------------------------------------

"Invoice Sales" { Customer, SKU, Versions, Years, Months } = "Gross Sales" - "Standard Discounts" - "Promo Discounts" - "Logistics Discounts"
  @rollup sum
  @folder "Margin"
  @readonly true

"Volume KG" { Customer, SKU, Versions, Years, Months } = "Volume" * "IMPORT Unit Weight"
  @rollup sum
  @folder "Margin"
  @notes "Net kg, after returns."
  @readonly true

"Handling KG" { Customer, SKU, Versions, Years, Months } = "Volume KG" * "IMPORT Handling Factor"
  @rollup sum
  @folder "Margin"
  @notes "Net kg weighted by temperature zone. A frozen kg counts as more than an ambient one."
  @readonly true

# --- Trade fees: pool per customer group and brand, key = invoice sales ------------------------

"Invoice Sales Positive" { Customer, SKU, Versions, Years, Months } = if(gt("Invoice Sales", 0), "Invoice Sales")
  @rollup sum
  @folder "Margin"
  @notes "Invoice sales where they are positive, per SKU line. The trade fee key uses it. A line whose returns beat its sales gets no share of a fee, while the customer's other SKUs still do."
  @readonly true

"Invoice Sales by Group Brand" { "Customer Group", Brand, Versions, Years, Months } = "Invoice Sales Positive"
  @rollup sum
  @folder "Margin"
  @readonly true

"Trade Fees Key" { Customer, SKU, Versions, Years, Months } = if(gt("Invoice Sales by Group Brand", 0), "Invoice Sales Positive" / "Invoice Sales by Group Brand")
  @rollup sum
  @folder "Margin"
  @readonly true

"Trade Fees" { Customer, SKU, Versions, Years, Months } = "Trade Fees Pool" * "Trade Fees Key"
  @rollup sum
  @folder "Margin"
  @readonly true

"Trade Fees Unallocated" { "Customer Group", Brand, Versions, Years, Months } = "Trade Fees Pool" - "Trade Fees"
  @rollup sum
  @folder "Margin"
  @notes "Fees for a brand the group had no positive sales of that month, for example a listing fee before the first delivery."
  @readonly true

# --- Net sales and gross margin ----------------------------------------------------------------

"Net Sales" { Customer, SKU, Versions, Years, Months } = "Invoice Sales" - "Rebates" - "Growth Bonus" - "Trade Fees" - "Promo Funding"
  @rollup sum
  @folder "Margin"
  @notes "Deductions that no customer could carry are not in it. The P&L holds them on their own lines."
  @readonly true

"Gross Margin" { Customer, SKU, Versions, Years, Months } = "Net Sales" - "COGS"
  @rollup sum
  @folder "Margin"
  @notes "Net sales less the cost of goods sold, at standard cost. A management margin after allocated trade deductions, readable by any customer, SKU or category. Deductions that no customer could carry are not in it."
  @readonly true

# --- Brought to customer and brand, where the cost pools are allocated ----------------------------

"Invoice Sales by Customer Brand" { Customer, Brand, Versions, Years, Months } = "Invoice Sales"
  @rollup sum
  @folder "Margin"
  @readonly true

"Net Sales by Customer Brand" { Customer, Brand, Versions, Years, Months } = "Net Sales"
  @rollup sum
  @folder "Margin"
  @readonly true

"Gross Margin by Customer Brand" { Customer, Brand, Versions, Years, Months } = "Gross Margin"
  @rollup sum
  @folder "Margin"
  @readonly true

"Handling KG by Customer Brand" { Customer, Brand, Versions, Years, Months } = "Handling KG"
  @rollup sum
  @folder "Margin"
  @readonly true

# --- Logistics: pool per country, key = handling kg --------------------------------------------

"Logistics Pool" { Country, Versions, Years, Months } = sum("OPEX", Function>Logistics)
  @rollup sum
  @folder "Margin"
  @notes "Warehouse and transport cost centers of the country."
  @readonly true

"Handling KG Positive" { Customer, Brand, Versions, Years, Months } = if(gt("Handling KG by Customer Brand", 0), "Handling KG by Customer Brand")
  @rollup sum
  @folder "Margin"
  @notes "Handling kg where they are positive. Net kg are only a stand-in for shipped kg. A customer whose returns beat its deliveries gets no logistics cost instead of a credit."
  @readonly true

"Handling KG by Country" { Country, Versions, Years, Months } = "Handling KG Positive"
  @rollup sum
  @folder "Margin"
  @readonly true

"Logistics Key" { Customer, Brand, Versions, Years, Months } = if(gt("Handling KG by Country", 0), "Handling KG Positive" / "Handling KG by Country")
  @rollup sum
  @folder "Margin"
  @readonly true

"Logistics Cost" { Customer, Brand, Versions, Years, Months } = "Logistics Pool" * "Logistics Key"
  @rollup sum
  @folder "Margin"
  @readonly true

"Logistics Unallocated" { Country, Versions, Years, Months } = "Logistics Pool" - "Logistics Cost"
  @rollup sum
  @folder "Margin"
  @notes "Logistics cost of a country and month with nothing shipped."
  @readonly true

# --- Sales force: pool per channel and country, key = invoice sales ----------------------------

"Sales Force Pool" { Channel, Country, Versions, Years, Months } = sum("OPEX", Function>Sales)
  @rollup sum
  @folder "Margin"
  @notes "Sales team cost centers. Each serves one channel in one country."
  @readonly true

"Invoice Sales Positive by Customer Brand" { Customer, Brand, Versions, Years, Months } = if(gt("Invoice Sales by Customer Brand", 0), "Invoice Sales by Customer Brand")
  @rollup sum
  @folder "Margin"
  @notes "A customer's invoice sales of a brand where they are positive. The sales force key uses it."
  @readonly true

"Invoice Sales by Channel Country" { Channel, Country, Versions, Years, Months } = "Invoice Sales Positive by Customer Brand"
  @rollup sum
  @folder "Margin"
  @readonly true

"Sales Force Key" { Customer, Brand, Versions, Years, Months } = if(gt("Invoice Sales by Channel Country", 0), "Invoice Sales Positive by Customer Brand" / "Invoice Sales by Channel Country")
  @rollup sum
  @folder "Margin"
  @readonly true

"Sales Force Cost" { Customer, Brand, Versions, Years, Months } = "Sales Force Pool" * "Sales Force Key"
  @rollup sum
  @folder "Margin"
  @readonly true

"Sales Force Unallocated" { Channel, Country, Versions, Years, Months } = "Sales Force Pool" - "Sales Force Cost"
  @rollup sum
  @folder "Margin"
  @notes "Cost of a sales team whose channel had no positive sales that month."
  @readonly true

# --- Contribution margin II, after the cost to serve -----------------------------------------------

"Contribution Margin II" { Customer, Brand, Versions, Years, Months } = "Gross Margin by Customer Brand" - "Logistics Cost" - "Sales Force Cost"
  @rollup sum
  @folder "Margin"
  @notes "Gross margin less the cost to serve the customer, logistics and the sales force. Both are allocated fixed pools, so dropping a customer would not save its share."
  @readonly true

# --- Marketing: pool per brand and country, key = net sales -------------------------------------

"Net Sales Positive" { Customer, Brand, Versions, Years, Months } = if(gt("Net Sales by Customer Brand", 0), "Net Sales by Customer Brand")
  @rollup sum
  @folder "Margin"
  @notes "A customer's net sales of a brand where they are positive. The marketing key uses it."
  @readonly true

"Net Sales by Brand Country" { Brand, Country, Versions, Years, Months } = "Net Sales Positive"
  @rollup sum
  @folder "Margin"
  @readonly true

"Marketing Key" { Customer, Brand, Versions, Years, Months } = if(gt("Net Sales by Brand Country", 0), "Net Sales Positive" / "Net Sales by Brand Country")
  @rollup sum
  @folder "Margin"
  @readonly true

"Marketing Cost" { Customer, Brand, Versions, Years, Months } = "Marketing Pool" * "Marketing Key"
  @rollup sum
  @folder "Margin"
  @readonly true

"Marketing Unallocated" { Brand, Country, Versions, Years, Months } = "Marketing Pool" - "Marketing Cost"
  @rollup sum
  @folder "Margin"
  @notes "Brand spend in a country and month with no positive net sales of the brand, for example a campaign before a launch."
  @readonly true

# --- Contribution margin III, after marketing ----------------------------------------------------

"Contribution Margin III" { Customer, Brand, Versions, Years, Months } = "Contribution Margin II" - "Marketing Cost"
  @rollup sum
  @folder "Margin"
  @notes "Contribution margin II less the brand's marketing, in the country's currency. Costs that no customer could carry are not in it. Layer 7 takes them off the country's profit."
  @readonly true
