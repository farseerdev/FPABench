# ============================================================================
# Layer 3. Planner inputs. These are the cells planners write.
#
# Each input sits at the grain the business decides at, which is mostly
# coarser than the sales grain. Formulas carry the values down.
# The benchmark dataset ships values for every plan version.
# Amounts are in local currency, except standard cost and the central
# marketing budget, which are in EUR.
# ============================================================================

# --- Volume -------------------------------------------------------------------
# Volume comes from a target, else from last year times growth. Both are
# driver-based choices of this benchmark. Many real models type volume at the
# sales grain instead, which Volume Override IN covers.

"Volume Growth IN" { Brand, Channel, Versions, Years }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "Planned volume growth against the same month last year. A blank means no growth."

"Volume Target IN" { "Customer Group", Category, Versions, Years }
  @rollup sum
  @folder "Inputs"
  @notes "Annual volume target in units for a chain or buying group and a category. Phased to customers, SKUs and months by last year's full-year mix. A version takes only the share of its plan months, so a forecast adds the rest of the target to its actuals. Where it exists it replaces the growth baseline."

"Volume Override IN" { Customer, SKU, Versions, Years, Months }
  @rollup sum
  @folder "Inputs"
  @notes "Volume typed by a key account manager. Replaces the baseline in that cell. Sparse."

# --- Price and gross-to-net ------------------------------------------------------

"Price Increase IN" { Brand, Versions, Years }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "List price increase on top of the list price of the last closed month."

"Standard Discount IN" { "Customer Group", Brand, Versions, Years, Months }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "Agreed on-invoice discount rate, as a share of gross sales. Where it is empty, the last actual rate carries forward."

"Promo Discount IN" { "Customer Group", Brand, Versions, Years, Months }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "Promotional on-invoice discount, as a share of gross sales. Sparse promotion calendar."

"Logistics Discount IN" { "Customer Group", Versions, Years, Months }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "On-invoice discount for full pallets delivered to the group's own warehouse, as a share of gross sales. Where nobody typed a rate, the plan keeps the group's last actual rate."

"Rebate Rate IN" { "Customer Group", Versions, Years, Months }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "Off-invoice rebate, as a share of invoice sales. Where it is empty, the last actual rate carries forward."

"Growth Bonus Rate IN" { "Customer Group", Versions, Years }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "Bonus as a share of invoice sales, for the whole year, if the group grows by more than its threshold. Type 0 for a group that will not earn it, which releases what the books accrued. A blank is no decision yet. The plan then keeps the accrual, and CHECK Growth Bonus shows it."

"Growth Bonus Threshold IN" { "Customer Group", Versions, Years }
  @rollup average
  @format percentage
  @folder "Inputs"
  @notes "Growth over last year's invoice sales that the group must beat to earn the bonus."

"Trade Fees IN" { "Customer Group", Brand, Versions, Years, Months }
  @rollup sum
  @folder "Inputs"
  @notes "Planned listing, shelf, leaflet and promotion fees per group and brand. An amount, not a rate."

"Promo Funding IN" { Customer, SKU, Versions, Years, Months }
  @rollup sum
  @folder "Inputs"
  @notes "Planned promotion payments per customer, SKU and month. Sparse."

# --- Cost and currency --------------------------------------------------------------

"Standard Cost IN" { SKU, Versions, Years }
  @rollup average
  @folder "Inputs"
  @notes "Planned standard cost per unit, in EUR. Where nobody typed one, the plan uses the SKU's actual standard cost of the year."

"FX Rate IN" { Currency, Versions, Years, Months }
  @rollup average
  @folder "Inputs"
  @notes "Planning rate, units of local currency per EUR. Where nobody typed a rate, the plan keeps the last actual rate."

"Marketing Spend IN" { Brand, Versions, Years, Months }
  @rollup sum
  @folder "Inputs"
  @notes "Planned advertising and promotion spend per brand, in EUR."

"Marketing Split IN" { Brand, Country, Versions, Years }
  @rollup sum
  @format percentage
  @folder "Inputs"
  @notes "Hand-entered allocation key: share of each brand's spend that goes to each country. Must add up to 1 per brand. CHECK Marketing Split shows the spend lost where it does not."

"OPEX IN" { "Cost Center", Account, Versions, Years, Months }
  @rollup sum
  @folder "Inputs"
  @notes "Planned operating expenses, entered by cost center managers."
