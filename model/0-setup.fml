# ============================================================================
# Layer 0. Version setup.
#
# Versions: Actual, Budget, FC 3+9, FC 6+6 and What-if. Two small inputs
# decide, for every version and month, whether the month shows actuals, plan,
# or nothing. Formulas never name a version. Moving the actuals cutoff or
# adding a forecast vintage is a data write.
#
# Reference data (Years Y2023..Y2026, actuals up to Y2026 M6):
#   Actual    closed Y2023 M1..Y2026 M6   horizon Y2023 M1..Y2026 M6
#   Budget    closed Y2023 M1..Y2025 M12  horizon Y2026 M1..M12
#   FC 3+9    closed Y2023 M1..Y2026 M3   horizon Y2026 M1..M12
#   FC 6+6    closed Y2023 M1..Y2026 M6   horizon Y2026 M1..M12
#   What-if   as FC 6+6, with its own copy of the planner inputs
# ============================================================================

"FC Closed IN" { Versions, Years, Months }
  @type integer
  @rollup average
  @folder "Setup"
  @notes "1 on every month that was already closed when the version was made. Inside its horizon the version shows the actuals of those months. Its plan starts from the last closed month. Empty elsewhere."

"FC Horizon IN" { Versions, Years, Months }
  @type integer
  @rollup average
  @folder "Setup"
  @notes "1 on every month the version reports. Empty elsewhere."

"FC Actual" { Versions, Years, Months } = "FC Horizon IN" * "FC Closed IN"
  @type integer
  @rollup average
  @folder "Setup"
  @notes "1 where the version shows actuals: inside its horizon and already closed."
  @readonly true

"FC Plan" { Versions, Years, Months } = if(not(hasValue("FC Closed IN")), "FC Horizon IN")
  @type integer
  @rollup sum
  @folder "Setup"
  @notes "1 where the version shows plan: inside its horizon and not yet closed. Summed over a year, it counts the plan months."
  @readonly true

"FC Plan Months" { Versions, Years } = "FC Plan"
  @type integer
  @rollup sum
  @folder "Setup"
  @notes "How many months of the year the version plans."
  @readonly true
