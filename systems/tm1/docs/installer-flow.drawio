<mxfile host="app.diagrams.net"><diagram id="installer" name="Installer v11 vs v12"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1390" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Install-FPBench.ps1: how the installer is designed to work (experimental; not validated on v11 or TM1 Database v12)" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1060" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Planning Analytics v11 (your own server, REST API on)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="460" height="1250" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Config&lt;/b&gt; (FPBench.config.psd1, kept out of git)&lt;br&gt;RestBaseUrl (https), sign-in (User + PasswordEnvVar, or CAMNamespace), WorkDir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="440" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Preflight&lt;/b&gt; (REST, read only, for every -From)&lt;br&gt;lists FPB cubes, FPB dimensions and z.FPB processes on the server;&lt;br&gt;-WhatIf stops here and prints the plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="320" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;would replace processes&lt;/b&gt; or &lt;b&gt;empty FPB cubes&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="n7" value="Stop, nothing changed:&lt;br&gt;-ReplaceProcesses / -Force" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="315" width="120" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;1. Data&lt;/b&gt;, on your machine (Node.js)&lt;br&gt;generate.mjs (FPABench) if WorkDir has no dataset;&lt;br&gt;stage-official.mjs: tm1_load, tm1_load_close-2026-07; stage-structure.mjs: tm1_structure&lt;br&gt;&lt;b&gt;Reference:&lt;/b&gt; fetch-expected.mjs downloads RAMA's expected.json into tm1_reference; picks-to-tm1.mjs: tm1_plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="440" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Files stay where they are&lt;/b&gt;&lt;br&gt;the server reads and writes the WorkDir folders and the package directly&lt;br&gt;(same machine, or a shared folder for a remote server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="440" height="70" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;2. Import&lt;/b&gt; (REST)&lt;br&gt;POST /Processes for new ones; PATCH existing ones only with -ReplaceProcesses&lt;br&gt;POST Processes('name')/tm1.Compile: any error stops the install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="440" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;3. Build&lt;/b&gt;: z.FPB.Build.All&lt;br&gt;pDir = folder names with \, e.g. C:\FPABench-10m\tm1_structure&lt;br&gt;20 dimensions, 4 cubes (only adds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="320" height="70" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;4. Setup&lt;/b&gt;&lt;br&gt;z.FPB.Setup.Model pApply 0 (dry run), then 1&lt;br&gt;z.FPB.Setup.GroupAttr, z.FPB.Setup.HandlingFactor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="320" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;5. Load&lt;/b&gt;: z.FPB.Run.L1 (FPABench L1)&lt;br&gt;pClear 1: empties the 4 cubes; loads tm1_load&lt;br&gt;RuleLoadFromFile from the package rules folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="320" height="70" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;6. Check&lt;/b&gt;&lt;br&gt;z.FPB.Check.Run: every SUMMARY count 0&lt;br&gt;compare.mjs: L1 answers against the FPABench reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="320" height="80" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Then Run-FPBench.ps1&lt;/b&gt; (same config)&lt;br&gt;- times every test through the REST API; undoes each run in the server&lt;br&gt;- R8, -FromSnapshot, -Affinity need the TM1 service on the same machine;&lt;br&gt;  the snapshot mirror refuses overlapping or non-TM1 folders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="440" height="100" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="no, or allowed by the switch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;One command:&lt;/b&gt;&lt;br&gt;Install-FPBench.ps1 -Config ... -Repo C:\FPABench&lt;br&gt;-WhatIf first; -From &amp;lt;stage&amp;gt; resumes after a failure.&lt;br&gt;Logs: WorkDir\tm1_logs" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="730" width="120" height="270" as="geometry"/></mxCell><mxCell id="n28" value="TM1 Database 12 (IBM Cloud Pak or as a Service; Linux containers, file storage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="460" height="1250" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Config&lt;/b&gt; (FPBench.config.psd1, kept out of git)&lt;br&gt;RestBaseUrl (https), sign-in (API key via RestAuthorization), WorkDir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="440" height="60" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Preflight&lt;/b&gt; (REST, read only, for every -From)&lt;br&gt;lists FPB cubes, FPB dimensions and z.FPB processes on the server;&lt;br&gt;-WhatIf stops here and prints the plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="190" width="320" height="80" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;would replace processes&lt;/b&gt; or &lt;b&gt;empty FPB cubes&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="n32" value="Stop, nothing changed:&lt;br&gt;-ReplaceProcesses / -Force" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="315" width="120" height="60" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;1. Data&lt;/b&gt;, on your machine (Node.js)&lt;br&gt;generate.mjs (FPABench) if WorkDir has no dataset;&lt;br&gt;stage-official.mjs: tm1_load, tm1_load_close-2026-07; stage-structure.mjs: tm1_structure&lt;br&gt;&lt;b&gt;Reference:&lt;/b&gt; fetch-expected.mjs downloads RAMA's expected.json into tm1_reference; picks-to-tm1.mjs: tm1_plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="440" height="80" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Upload to file storage&lt;/b&gt; (not in the installer yet)&lt;br&gt;rules, stage\empty, tm1_load, tm1_load_close-2026-07, tm1_structure, master CSVs, tm1_plan\W2_cells.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;dashed=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="530" width="440" height="70" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;2. Import&lt;/b&gt; (REST)&lt;br&gt;POST /Processes for new ones; PATCH existing ones only with -ReplaceProcesses&lt;br&gt;POST Processes('name')/tm1.Compile: any error stops the install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="630" width="440" height="70" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;3. Build&lt;/b&gt;: z.FPB.Build.All&lt;br&gt;pDir = folder names with /, e.g. fpb/tm1_structure&lt;br&gt;20 dimensions, 4 cubes (only adds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="730" width="320" height="70" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;4. Setup&lt;/b&gt;&lt;br&gt;z.FPB.Setup.Model pApply 0 (dry run), then 1&lt;br&gt;z.FPB.Setup.GroupAttr, z.FPB.Setup.HandlingFactor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="830" width="320" height="70" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;5. Load&lt;/b&gt;: z.FPB.Run.L1 (FPABench L1)&lt;br&gt;pClear 1: empties the 4 cubes; loads tm1_load&lt;br&gt;RuleLoadFromFile from the package rules folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="930" width="320" height="70" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;6. Check&lt;/b&gt;&lt;br&gt;z.FPB.Check.Run and the L1 answers are written to file storage:&lt;br&gt;&lt;i&gt;downloading them for compare.mjs is not in the installer yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;dashed=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="1030" width="320" height="80" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Then Run-FPBench.ps1&lt;/b&gt;, with limits on v12:&lt;br&gt;- runs and times every process through the REST API&lt;br&gt;- answer files and undo journals live in file storage: not adapted yet&lt;br&gt;- R8, -FromSnapshot, -Affinity: no Windows service, not available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;dashed=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="1140" width="440" height="100" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="no, or allowed by the switch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n35" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n36" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n37" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n38" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n39" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;Same as v11:&lt;/b&gt; config, preflight, Data, the 28 processes, Import, Build, Setup and Load.&lt;br&gt;&lt;b&gt;Different:&lt;/b&gt; files must be uploaded first, folder parameters are file-storage names with /, results are read back through the REST API." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="950" y="730" width="120" height="270" as="geometry"/></mxCell><mxCell id="n53" value="In the installer today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1325" width="180" height="40" as="geometry"/></mxCell><mxCell id="n54" value="Not in the installer yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;dashed=1;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="1325" width="180" height="40" as="geometry"/></mxCell><mxCell id="n55" value="Handled by the server itself (v11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="440" y="1325" width="200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>